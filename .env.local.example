# Copy this file to .env.local for local development, and add the same
# values in Vercel: Project Settings > Environment Variables.

# From Supabase: Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# The password guests type in to see the site. Pick your own, and change it
# any time by updating this value and redeploying.
WEDDING_PASSWORD=pick-your-own-guest-password

# A separate password only you use to reach /admin — pick your own, keep it private.
ADMIN_PASSWORD=change-me-to-your-own-admin-password
